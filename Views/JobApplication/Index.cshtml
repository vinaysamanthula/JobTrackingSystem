@model JobTrackingSystem.ViewModels.JobApplicationSearchVm

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-list-check text-primary fs-2"></i>
                    </div>
                    <div>
                        <h1 class="display-6 fw-bold mb-1">Job Applications</h1>
                        <p class="text-muted mb-0">
                            <i class="bi bi-clock-history me-1"></i>
                            Manage and track all your job applications
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="ExportExcel"
                       class="btn btn-success">
                        <i class="bi bi-file-earmark-excel"></i>
                        Export Excel
                    </a>
                    @* <a asp-action="Deleted" class="btn btn-outline-secondary">
                        <i class="bi bi-archive me-1"></i> Deleted
                    </a> *@
                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-lg me-1"></i> Add Application
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-action="Index" class="text-decoration-none d-block">
                <div class="card border-0 shadow-sm h-100 text-center hover-shadow transition-all">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-center mb-1">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-circle">
                                <i class="bi bi-briefcase text-primary"></i>
                            </div>
                        </div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-0">Total</h6>
                        <h3 class="fw-bold mb-0 text-primary">@Model.TotalApplications</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-action="Index" asp-route-status="Applied" class="text-decoration-none d-block">
                <div class="card border-0 shadow-sm h-100 text-center hover-shadow transition-all border-start border-4 border-info">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-center mb-1">
                            <div class="bg-info bg-opacity-10 p-2 rounded-circle">
                                <i class="bi bi-send text-info"></i>
                            </div>
                        </div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-0">Applied</h6>
                        <h3 class="fw-bold mb-0 text-info">@Model.AppliedCount</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-action="Index" asp-route-status="Interview" class="text-decoration-none d-block">
                <div class="card border-0 shadow-sm h-100 text-center hover-shadow transition-all border-start border-4 border-warning">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-center mb-1">
                            <div class="bg-warning bg-opacity-10 p-2 rounded-circle">
                                <i class="bi bi-chat-dots text-warning"></i>
                            </div>
                        </div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-0">Interview</h6>
                        <h3 class="fw-bold mb-0 text-warning">@Model.InterviewCount</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-action="Index" asp-route-status="Offer" class="text-decoration-none d-block">
                <div class="card border-0 shadow-sm h-100 text-center hover-shadow transition-all border-start border-4 border-success">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-center mb-1">
                            <div class="bg-success bg-opacity-10 p-2 rounded-circle">
                                <i class="bi bi-trophy text-success"></i>
                            </div>
                        </div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-0">Offer</h6>
                        <h3 class="fw-bold mb-0 text-success">@Model.OfferCount</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-action="Index" asp-route-status="Rejected" class="text-decoration-none d-block">
                <div class="card border-0 shadow-sm h-100 text-center hover-shadow transition-all border-start border-4 border-danger">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-center mb-1">
                            <div class="bg-danger bg-opacity-10 p-2 rounded-circle">
                                <i class="bi bi-x-circle text-danger"></i>
                            </div>
                        </div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-0">Rejected</h6>
                        <h3 class="fw-bold mb-0 text-danger">@Model.RejectedCount</h3>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
            <i class="bi bi-filters text-primary"></i>
            <h5 class="fw-bold mb-0">Filter Applications</h5>
        </div>
        <div class="card-body p-4">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <div class="form-floating">
                        <input asp-for="Keyword" class="form-control" placeholder="Company, Role, Notes..." />
                        <label asp-for="Keyword">
                            <i class="bi bi-search me-1"></i> Keyword
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <select asp-for="SortBy" class="form-select" id="sortSelect">
                            <option value="date">Newest First</option>
                            <option value="company">Company</option>
                            <option value="status">Status</option>
                        </select>
                        <label for="sortSelect">
                            <i class="bi bi-arrow-up-down me-1"></i> Sort By
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <select asp-for="Status" class="form-select" id="statusFilterSelect">
                            <option value="">All</option>
                            <option value="Applied">Applied</option>
                            <option value="Interview">Interview</option>
                            <option value="Offer">Offer</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                        <label for="statusFilterSelect">
                            <i class="bi bi-tag me-1"></i> Status
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <select asp-for="CompanyId" asp-items="Model.Companies" class="form-select" id="companyFilterSelect">
                            <option value="">All Companies</option>
                        </select>
                        <label for="companyFilterSelect">
                            <i class="bi bi-building me-1"></i> Company
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input asp-for="FromDate" type="date" class="form-control" />
                        <label asp-for="FromDate">
                            <i class="bi bi-calendar-start me-1"></i> From
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input asp-for="ToDate" type="date" class="form-control" />
                        <label asp-for="ToDate">
                            <i class="bi bi-calendar-end me-1"></i> To
                        </label>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2 mt-3">
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-clockwise me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><i class="bi bi-building me-1"></i> Company</th>
                            <th><i class="bi bi-briefcase me-1"></i> Role</th>
                            <th><i class="bi bi-tag me-1"></i> Status</th>
                            <th><i class="bi bi-calendar me-1"></i> Date Applied</th>
                            <th><i class="bi bi-sticky me-1"></i> Notes</th>
                            <th class="text-center" width="140">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Results.Any())
                        {
                            @foreach (var item in Model.Results)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.Company?.Name</span>
                                    </td>
                                    <td>@item.Role</td>
                                    <td>
                                        @if (item.Status == "Applied")
                                        {
                                            <span class="badge bg-primary">Applied</span>
                                        }
                                        else if (item.Status == "Interview")
                                        {
                                            <span class="badge bg-warning text-dark">Interview</span>
                                        }
                                        else if (item.Status == "Offer")
                                        {
                                            <span class="badge bg-success">Offer</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                    </td>
                                    <td>@item.DateApplied.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="text-muted small text-truncate d-inline-block" style="max-width: 200px;">
                                            @item.Notes
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="text-center py-4">
                                        <i class="bi bi-inbox fs-1 text-muted"></i>
                                        <p class="text-muted mb-0 mt-2">No applications found matching your filters.</p>
                                        <small class="text-muted">Try adjusting your search criteria</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="text-muted small">
                        <i class="bi bi-file-text me-1"></i>
                        Page @Model.Page of @Model.TotalPages
                    </span>
                    <div class="d-flex gap-2">
                        @if (Model.Page > 1)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-companyId="@Model.CompanyId"
                               asp-route-sortBy="@Model.SortBy"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-chevron-left me-1"></i> Previous
                            </a>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-companyId="@Model.CompanyId"
                               asp-route-sortBy="@Model.SortBy"
                               class="btn btn-outline-secondary btn-sm">
                                Next <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>


