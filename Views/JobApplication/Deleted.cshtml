@model List<JobTrackingSystem.Models.JobApplication>

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-secondary bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-archive-fill text-secondary fs-2"></i>
                    </div>
                    <div>
                        <h1 class="display-6 fw-bold mb-1">Deleted Applications</h1>
                        <p class="text-muted mb-0">
                            <i class="bi bi-clock-history me-1"></i>
                            Restore previously deleted applications
                        </p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="bi bi-building me-1"></i> Company</th>
                                <th><i class="bi bi-briefcase me-1"></i> Role</th>
                                <th><i class="bi bi-calendar me-1"></i> Date Applied</th>
                                <th><i class="bi bi-tag me-1"></i> Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.Company?.Name</span>
                                    </td>
                                    <td>@item.Role</td>
                                    <td>@item.DateApplied.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge bg-secondary">Deleted</span>
                                    </td>
                                    <td>
                                        <form asp-action="Restore" method="post" class="d-flex justify-content-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-success btn-sm px-3">
                                                <i class="bi bi-arrow-clockwise me-1"></i> Restore
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mb-0 mt-2">No deleted applications found.</p>
                    <small class="text-muted">Deleted items will appear here for restoration</small>
                </div>
            }
        </div>
    </div>
</div>