@{
}
@model JobApplicationSearchVm

<h2>Search Job Applications</h2>

<form method="get">
    <input asp-for="Keyword" class="form-control" placeholder="Search Role or Notes" />

    <select asp-for="Status">
        <option value="">All Status</option>
        <option>Applied</option>
        <option>Interview</option>
        <option>Rejected</option>
        <option>Offer</option>
    </select>

    <select asp-for="CompanyId" asp-items="Model.Companies">
        <option value="">All Companies</option>
    </select>

    <input asp-for="FromDate" type="date" />
    <input asp-for="ToDate" type="date" />

    <button type="submit">Search</button>
</form>

<hr />
<p><strong>@Model.Results.Count</strong> result(s) found</p>
<table class="table table-bordered table-striped mt-3">
    <thead>
        <tr>
            <th>Company</th>
            <th>Role</th>
            <th>Status</th>
            <th>Date Applied</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Results.Any())
        {
            foreach (var item in Model.Results)
            {
                <tr>
                    <td>@item.Company?.Name</td>
                    <td>@item.Role</td>
                    <td>
                        <span class="badge bg-primary">@item.Status</span>
                    </td>
                    <td>@item.DateApplied.ToShortDateString()</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">
                    No results found
                </td>
            </tr>
        }
    </tbody>
</table<div class="mt-3">

    @if (Model.Page > 1)
    {
        <a asp-action="Search"
           asp-route-Page="@(Model.Page - 1)"
           asp-route-Keyword="@Model.Keyword"
           asp-route-Status="@Model.Status"
           asp-route-CompanyId="@Model.CompanyId">
           Previous
        </a>
    }

    <span> Page @Model.Page of @Model.TotalPages </span>

    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="Search"
           asp-route-Page="@(Model.Page + 1)"
           asp-route-Keyword="@Model.Keyword"
           asp-route-Status="@Model.Status"
           asp-route-CompanyId="@Model.CompanyId">
           Next
        </a>
    }

</div>
