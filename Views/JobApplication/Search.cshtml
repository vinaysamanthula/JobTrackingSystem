@model JobTrackingSystem.ViewModels.JobApplicationSearchVm

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-info bg-opacity-10 p-3 rounded-3">
                    <i class="bi bi-search text-info fs-2"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-1">Search Applications</h1>
                    <p class="text-muted mb-0">
                        <i class="bi bi-funnel me-1"></i>
                        Filter and find specific job applications
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Form Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" asp-action="Search" class="row g-3">
                <div class="col-md-4">
                    <div class="form-floating">
                        <input asp-for="Keyword" class="form-control" placeholder="Search Role or Notes" />
                        <label asp-for="Keyword">
                            <i class="bi bi-search me-1"></i> Keyword
                        </label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <select asp-for="Status" class="form-select" id="statusSelect">
                            <option value="">All Status</option>
                            <option value="Applied">📝 Applied</option>
                            <option value="Interview">🎯 Interview</option>
                            <option value="Offer">🎉 Offer</option>
                            <option value="Rejected">❌ Rejected</option>
                        </select>
                        <label for="statusSelect">
                            <i class="bi bi-tag me-1"></i> Status
                        </label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <select asp-for="CompanyId" asp-items="Model.Companies" class="form-select" id="companySelect">
                            <option value="">All Companies</option>
                        </select>
                        <label for="companySelect">
                            <i class="bi bi-building me-1"></i> Company
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input asp-for="FromDate" type="date" class="form-control" />
                        <label asp-for="FromDate">
                            <i class="bi bi-calendar-start me-1"></i> From
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input asp-for="ToDate" type="date" class="form-control" />
                        <label asp-for="ToDate">
                            <i class="bi bi-calendar-end me-1"></i> To
                        </label>
                    </div>
                </div>

                <div class="col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                    <a asp-action="Search" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-clockwise me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
            <div>
                <h5 class="fw-bold mb-0">Search Results</h5>
            </div>
            <span class="badge bg-primary">
                <i class="bi bi-list-ul me-1"></i>
                @Model.Results.Count result(s) found
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model.Results.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="bi bi-building me-1"></i> Company</th>
                                <th><i class="bi bi-briefcase me-1"></i> Role</th>
                                <th><i class="bi bi-tag me-1"></i> Status</th>
                                <th><i class="bi bi-calendar me-1"></i> Date Applied</th>
                                <th><i class="bi bi-sticky me-1"></i> Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Results)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.Company?.Name</span>
                                    </td>
                                    <td>@item.Role</td>
                                    <td>
                                        @if (item.Status == "Applied")
                                        {
                                            <span class="badge bg-primary">Applied</span>
                                        }
                                        else if (item.Status == "Interview")
                                        {
                                            <span class="badge bg-warning text-dark">Interview</span>
                                        }
                                        else if (item.Status == "Offer")
                                        {
                                            <span class="badge bg-success">Offer</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                    </td>
                                    <td>@item.DateApplied.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="text-muted small">@item.Notes</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-search fs-1 text-muted"></i>
                    <p class="text-muted mb-0 mt-2">No results found</p>
                    <small class="text-muted">Try adjusting your search filters</small>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="bi bi-file-text me-1"></i>
                        Page @Model.Page of @Model.TotalPages
                    </span>
                    <div class="d-flex gap-2">
                        @if (Model.Page > 1)
                        {
                            <a asp-action="Search"
                               asp-route-Page="@(Model.Page - 1)"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-Status="@Model.Status"
                               asp-route-CompanyId="@Model.CompanyId"
                               asp-route-FromDate="@Model.FromDate"
                               asp-route-ToDate="@Model.ToDate"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-chevron-left me-1"></i> Previous
                            </a>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-action="Search"
                               asp-route-Page="@(Model.Page + 1)"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-Status="@Model.Status"
                               asp-route-CompanyId="@Model.CompanyId"
                               asp-route-FromDate="@Model.FromDate"
                               asp-route-ToDate="@Model.ToDate"
                               class="btn btn-outline-secondary btn-sm">
                                Next <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>