@model JobTrackingSystem.ViewModels.JobApplicationCreateVm

<h2>Create Job Application</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label>Company</label>
        <select asp-for="CompanyId" asp-items="Model.Companies">
            <option value="">-- Select Company --</option>
        </select>
        <span asp-validation-for="CompanyId" class="text-danger"></span>
    </div>

    <br />

    <div>
        <label>Role</label>
        <input asp-for="Role" />
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <br />

    <div>
        <label>Status</label>
        <select asp-for="Status">
            <option value="">-- Select Status --</option>
            <option>Applied</option>
            <option>Interview</option>
            <option>Rejected</option>
            <option>Offer</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <br />

    <div>
        <label>Date Applied</label>
        <input asp-for="DateApplied" type="date" />
        <span asp-validation-for="DateApplied" class="text-danger"></span>
    </div>

    <br />

    <div>
        <label>Notes</label>
        <textarea asp-for="Notes"></textarea>
    </div>

    <br />

    <button type="submit">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}