@model JobTrackingSystem.ViewModels.JobApplicationEditVm

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-warning bg-opacity-10 p-3 rounded-3">
                    <i class="bi bi-pencil-square text-warning fs-2"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-1">Edit Job Application</h1>
                    <p class="text-muted mb-0">
                        <i class="bi bi-pencil me-1"></i>
                        Update your job application details
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="row g-4">
                    <!-- Company -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="CompanyId" asp-items="Model.Companies" class="form-select" id="companySelect">
                                <option value="">Select company</option>
                            </select>
                            <label for="companySelect">
                                <i class="bi bi-building me-1"></i> Company
                            </label>
                        </div>
                        <span asp-validation-for="CompanyId" class="text-danger small"></span>
                    </div>

                    <!-- Role -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Role" class="form-control" placeholder="e.g. Software Engineer" />
                            <label asp-for="Role">
                                <i class="bi bi-briefcase me-1"></i> Role
                            </label>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="Status" class="form-select" id="statusSelect">
                                <option value="">-- Select Status --</option>
                                <option value="Applied">📝 Applied</option>
                                <option value="Interview">🎯 Interview</option>
                                <option value="Offer">🎉 Offer</option>
                                <option value="Rejected">❌ Rejected</option>
                            </select>
                            <label for="statusSelect">
                                <i class="bi bi-tag me-1"></i> Status
                            </label>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <!-- Date Applied -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="DateApplied" type="date" class="form-control" />
                            <label asp-for="DateApplied">
                                <i class="bi bi-calendar3 me-1"></i> Date Applied
                            </label>
                        </div>
                        <span asp-validation-for="DateApplied" class="text-danger small"></span>
                    </div>

                    <!-- Notes -->
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Optional notes..." style="height: 120px;"></textarea>
                            <label asp-for="Notes">
                                <i class="bi bi-sticky me-1"></i> Notes
                            </label>
                        </div>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-warning px-5">
                        <i class="bi bi-check-lg me-1"></i> Update Application
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}